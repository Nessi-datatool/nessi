FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    default-jdk \
    wget \
    curl \
    git \
    libssl-dev \
    libffi-dev \
    python3-dev \
    libsnappy-dev \
    libzstd-dev \
    liblz4-dev \
    libbrotli-dev \
    && rm -rf /var/lib/apt/lists/*

# Download and install Spark
RUN wget -q https://archive.apache.org/dist/spark/spark-3.4.1/spark-3.4.1-bin-hadoop3.tgz \
    && tar xzf spark-3.4.1-bin-hadoop3.tgz \
    && mv spark-3.4.1-bin-hadoop3 /opt/spark \
    && rm spark-3.4.1-bin-hadoop3.tgz

# Download Delta Lake JARs
RUN wget -P /opt/spark/jars https://repo1.maven.org/maven2/io/delta/delta-core_2.12/2.4.0/delta-core_2.12-2.4.0.jar \
    && wget -P /opt/spark/jars https://repo1.maven.org/maven2/io/delta/delta-storage/2.4.0/delta-storage-2.4.0.jar

# Set environment variables
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
ENV SPARK_HOME=/opt/spark
ENV PYTHONPATH=/app/src
ENV PATH=$SPARK_HOME/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV DOCKER_TESTING=1
ENV DOCKER_ENV=true
ENV PYTEST_DOCKER_ONLY=true

# Set working directory
WORKDIR /app

# Install Python dependencies
COPY requirements.txt requirements-test.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-test.txt

# Copy source code and install package in development mode
COPY . .
RUN pip install -e .

# Create necessary directories
RUN mkdir -p /app/data /app/logs /app/test-results /app/.benchmarks

# Configure Spark for optimal performance
COPY docker/spark-defaults.conf /opt/spark/conf/
RUN echo "spark.driver.memory=$(free -m | awk '/^Mem:/{print int($2*0.8)}')m" >> /opt/spark/conf/spark-defaults.conf \
    && echo "spark.executor.memory=$(free -m | awk '/^Mem:/{print int($2*0.8)}')m" >> /opt/spark/conf/spark-defaults.conf

# Create test user and set permissions
RUN useradd -m -s /bin/bash tester \
    && chown -R tester:tester /app \
    && chmod -R 755 /app

USER tester

# Default command to run tests
CMD ["python", "-m", "pytest", "-v", "tests/"]

# Expose ports for test services
EXPOSE 8080 9090 9093 3000

# Default command (can be overridden by docker-compose)
CMD ["pytest", "tests/", "-v"] 